  "as-virtudes": {
    "title": "As quatro virtudes",
    "kind": "principal",
    "xp": 120,
    "stages": [
      {
        "id": "juntar-emblemas",
        "objective": "Entre nos quatro quadros da Galeria e traga os emblemas das virtudes.",
        "completeWhen": {
          "any": [
            {
              "all": [
                {
                  "hasItem": "emblema-coragem"
                },
                {
                  "hasItem": "emblema-inteligencia"
                },
                {
                  "hasItem": "emblema-astucia"
                },
                {
                  "hasItem": "emblema-lealdade"
                }
              ]
            },
            {
              "all": [
                {
                  "kids": true
                },
                {
                  "hasItem": "emblema-coragem"
                },
                {
                  "hasItem": "emblema-lealdade"
                }
              ]
            }
          ]
        },
        "then": "ir-ao-coracao",
        "guia": [
          {
            "map": "map.quadro-coragem",
            "alvo": "emblema",
            "when": {
              "not": {
                "hasItem": "emblema-coragem"
              }
            }
          },
          {
            "map": "map.quadro-inteligencia",
            "alvo": "cristal",
            "when": {
              "all": [
                {
                  "kids": false
                },
                {
                  "all": [
                    {
                      "not": {
                        "hasItem": "emblema-inteligencia"
                      }
                    },
                    {
                      "not": {
                        "flag": "luz:map.quadro-inteligencia:cristal"
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "map": "map.quadro-inteligencia",
            "alvo": "emblema",
            "when": {
              "all": [
                {
                  "kids": false
                },
                {
                  "not": {
                    "hasItem": "emblema-inteligencia"
                  }
                }
              ]
            }
          },
          {
            "map": "map.quadro-astucia",
            "alvo": "emblema",
            "when": {
              "all": [
                {
                  "kids": false
                },
                {
                  "not": {
                    "hasItem": "emblema-astucia"
                  }
                }
              ]
            }
          },
          {
            "map": "map.quadro-lealdade",
            "alvo": "amelia",
            "when": {
              "not": {
                "hasItem": "emblema-lealdade"
              }
            }
          }
        ],
        "kidsObjective": "Entre nos quadros da Coragem e da Lealdade e traga os dois emblemas."
      },
      {
        "id": "ir-ao-coracao",
        "objective": "Passe pela barreira a leste da Galeria até o Coração do Castelo.",
        "completeWhen": {
          "flag": "visto:morgana-duelo"
        },
        "then": "enfrentar-morgana",
        "guia": [
          {
            "map": "map.coracao",
            "alvo": "duelo"
          }
        ]
      },
      {
        "id": "enfrentar-morgana",
        "objective": "Duelo! Lumen quando a Bellatrix cansar; Revelar quando ela sumir.",
        "completeWhen": {
          "flag": "morgana:convencida"
        },
        "then": "acender-coracao"
      },
      {
        "id": "acender-coracao",
        "objective": "Toque o Coração do Castelo.",
        "guia": [
          {
            "map": "map.coracao",
            "alvo": "coracao"
          }
        ]
      }
    ]
  },
