{
  "primeira-noite": {
    "title": "Primeira noite no castelo",
    "kind": "principal",
    "xp": 20,
    "stages": [
      {
        "id": "falar-com-quadro",
        "objective": "Fale com o quadro vivo no Grande Salão.",
        "guia": [
          {
            "map": "map.grande-salao",
            "alvo": "dom-moldura"
          }
        ],
        "dicas": [
          "Da Recepção, a porta ao norte leva ao Grande Salão.",
          "O Dom Moldura é o quadro de bigode no meio da parede norte do Grande Salão. Fique de frente para ele e aperte Espaço."
        ]
      },
      {
        "id": "voltar-ao-trinco",
        "objective": "Conte ao Trinco o que o quadro disse.",
        "guia": [
          {
            "map": "map.recepcao",
            "alvo": "trinco"
          }
        ],
        "dicas": [
          "O Trinco fica atrás do balcão da Recepção, ao sul do Grande Salão."
        ]
      }
    ]
  },
  "luz-na-cozinha": {
    "title": "Luz na Cozinha",
    "kind": "principal",
    "xp": 30,
    "stages": [
      {
        "id": "ir-a-cozinha",
        "objective": "Vá até a Cozinha Bruxa, a leste do Grande Salão.",
        "guia": [
          {
            "map": "map.cozinha",
            "alvo": "dona-brasa"
          }
        ],
        "dicas": [
          "A Cozinha Bruxa fica pela porta leste do Grande Salão."
        ]
      },
      {
        "id": "preparar-drink",
        "objective": "Prepare um Drink Bruxo Fumegante no caldeirão: suco colorido + gelo seco.",
        "completeWhen": {
          "hasItem": "drink-fumegante"
        },
        "then": "entregar-drink",
        "guia": [
          {
            "map": "map.cozinha",
            "alvo": "despensa",
            "when": {
              "not": {
                "all": [
                  {
                    "hasItem": "suco-colorido"
                  },
                  {
                    "hasItem": "gelo-seco"
                  }
                ]
              }
            }
          },
          {
            "map": "map.cozinha",
            "alvo": "caldeirao"
          }
        ],
        "dicas": [
          "O suco colorido está na cozinha e o gelo seco ficou no Grande Salão. A despensa da cozinha também tem os dois.",
          "Com os dois na bolsa, use o caldeirão grande da cozinha, coloque os ingredientes e escolha Mexer."
        ]
      },
      {
        "id": "entregar-drink",
        "objective": "Leve o drink para a Dona Brasa.",
        "guia": [
          {
            "map": "map.cozinha",
            "alvo": "dona-brasa"
          }
        ],
        "dicas": [
          "A Dona Brasa está na cozinha. Fique de frente para ela e aperte Espaço."
        ]
      },
      {
        "id": "acender-velas",
        "objective": "Acenda as 2 velas da cozinha com Lumen (troque o feitiço e use a ação).",
        "completeWhen": {
          "all": [
            {
              "flag": "vela:map.cozinha:vela-a"
            },
            {
              "flag": "vela:map.cozinha:vela-b"
            }
          ]
        },
        "then": "falar-com-brasa",
        "guia": [
          {
            "map": "map.cozinha",
            "alvo": "vela-a",
            "when": {
              "not": {
                "flag": "vela:map.cozinha:vela-a"
              }
            }
          },
          {
            "map": "map.cozinha",
            "alvo": "vela-b"
          }
        ],
        "dicas": [
          "Aperte Q até aparecer Lumen no canto da tela.",
          "Fique de frente para cada vela da bancada e aperte Espaço para lançar o Lumen."
        ]
      },
      {
        "id": "falar-com-brasa",
        "objective": "Volte a falar com a Dona Brasa.",
        "guia": [
          {
            "map": "map.cozinha",
            "alvo": "dona-brasa"
          }
        ],
        "dicas": [
          "As duas velas estão acesas: fale de novo com a Dona Brasa."
        ]
      }
    ]
  },
  "o-diretor": {
    "title": "O Ministro da Magia",
    "kind": "principal",
    "xp": 40,
    "stages": [
      {
        "id": "ir-ao-corredor",
        "objective": "Vá ao Corredor dos Quadros (porta oeste do Grande Salão) e procure o gabinete do Ministro Bonfatti.",
        "completeWhen": {
          "flag": "visto:morgana-corredor"
        },
        "then": "espantar-sombras",
        "guia": [
          {
            "map": "map.corredor",
            "alvo": "morgana-corredor"
          }
        ],
        "dicas": [
          "O Corredor dos Quadros fica pela porta oeste do Grande Salão."
        ]
      },
      {
        "id": "espantar-sombras",
        "objective": "Espante as sombrinhas com Lumen!",
        "completeWhen": {
          "flag": "criaturas:map.corredor:sombras"
        },
        "then": "abrir-grade",
        "guia": [
          {
            "map": "map.corredor",
            "alvo": "sombra-1"
          }
        ],
        "dicas": [
          "Escolha o Lumen (Q) e lance de frente para cada sombrinha. Se a energia acabar, espere ela voltar."
        ]
      },
      {
        "id": "abrir-grade",
        "objective": "Empurre as duas estátuas até as placas do chão para abrir a grade do gabinete.",
        "completeWhen": {
          "flag": "placas:map.corredor:grade"
        },
        "then": "falar-com-diretor",
        "guia": [
          {
            "map": "map.corredor",
            "alvo": "grade"
          }
        ],
        "dicas": [
          "As estátuas só andam quando você empurra: encoste nelas e continue andando.",
          "Cada estátua precisa parar em cima de uma placa no chão. Leve primeiro para o lado e depois para baixo.",
          "Travou uma estátua num canto? Saia da sala e volte: elas voltam ao lugar."
        ]
      },
      {
        "id": "falar-com-diretor",
        "objective": "Converse com o Ministro Bonfatti no gabinete.",
        "guia": [
          {
            "map": "map.gabinete",
            "alvo": "arquimedes"
          }
        ],
        "dicas": [
          "A grade abriu! O gabinete do Bonfatti é a porta no meio do corredor, ao norte."
        ]
      },
      {
        "id": "ir-ao-hall",
        "objective": "Siga o Ministro Bonfatti até o Hall da Escada, no fim oeste do corredor.",
        "guia": [
          {
            "map": "map.hall",
            "alvo": "arquimedes"
          }
        ],
        "dicas": [
          "O Hall da Escada fica no fim oeste do Corredor dos Quadros."
        ]
      }
    ]
  },
  "o-selo": {
    "title": "O Selo da Escada",
    "kind": "principal",
    "xp": 80,
    "stages": [
      {
        "id": "reunir-pedras",
        "objective": "Reúna as 4 pedras das casas: Coragem, Inteligência, Astúcia e Lealdade. O Elfo Fuxico, no Grande Salão, dá dicas.",
        "completeWhen": {
          "all": [
            {
              "any": [
                {
                  "hasItem": "pedra-coragem"
                },
                {
                  "flag": "encaixe:map.hall:pedestal-coragem"
                }
              ]
            },
            {
              "any": [
                {
                  "hasItem": "pedra-inteligencia"
                },
                {
                  "flag": "encaixe:map.hall:pedestal-inteligencia"
                }
              ]
            },
            {
              "any": [
                {
                  "hasItem": "pedra-astucia"
                },
                {
                  "flag": "encaixe:map.hall:pedestal-astucia"
                }
              ]
            },
            {
              "any": [
                {
                  "hasItem": "pedra-lealdade"
                },
                {
                  "flag": "encaixe:map.hall:pedestal-lealdade"
                }
              ]
            }
          ]
        },
        "then": "colocar-pedras",
        "guia": [
          {
            "map": "map.hall",
            "alvo": "pedra-coragem",
            "when": {
              "not": {
                "any": [
                  {
                    "hasItem": "pedra-coragem"
                  },
                  {
                    "flag": "encaixe:map.hall:pedestal-coragem"
                  }
                ]
              }
            }
          },
          {
            "map": "map.grande-salao",
            "alvo": "dom-moldura",
            "when": {
              "not": {
                "any": [
                  {
                    "hasItem": "pedra-inteligencia"
                  },
                  {
                    "flag": "encaixe:map.hall:pedestal-inteligencia"
                  }
                ]
              }
            }
          },
          {
            "map": "map.corredor",
            "alvo": "pedra-astucia",
            "when": {
              "not": {
                "any": [
                  {
                    "hasItem": "pedra-astucia"
                  },
                  {
                    "flag": "encaixe:map.hall:pedestal-astucia"
                  }
                ]
              }
            }
          },
          {
            "map": "map.recepcao",
            "alvo": "trinco",
            "when": {
              "not": {
                "any": [
                  {
                    "hasItem": "pedra-lealdade"
                  },
                  {
                    "flag": "encaixe:map.hall:pedestal-lealdade"
                  }
                ]
              }
            }
          }
        ],
        "dicas": [
          "Coragem: no Hall, cercada de sombrinhas (Lumen). Inteligência: a charada do Dom Moldura. Astúcia: atrás dos caixotes do corredor (Levitar). Lealdade: fale com o Trinco.",
          "O Fuxico, no Grande Salão, diz qual pedra ainda falta. Abra o grimório (I) para ver quais pedras já estão na bolsa."
        ]
      },
      {
        "id": "colocar-pedras",
        "objective": "Coloque as 4 pedras nos pedestais do Hall da Escada.",
        "guia": [
          {
            "map": "map.hall",
            "alvo": "pedestal-coragem",
            "when": {
              "not": {
                "flag": "encaixe:map.hall:pedestal-coragem"
              }
            }
          },
          {
            "map": "map.hall",
            "alvo": "pedestal-inteligencia",
            "when": {
              "not": {
                "flag": "encaixe:map.hall:pedestal-inteligencia"
              }
            }
          },
          {
            "map": "map.hall",
            "alvo": "pedestal-astucia",
            "when": {
              "not": {
                "flag": "encaixe:map.hall:pedestal-astucia"
              }
            }
          },
          {
            "map": "map.hall",
            "alvo": "pedestal-lealdade",
            "when": {
              "not": {
                "flag": "encaixe:map.hall:pedestal-lealdade"
              }
            }
          }
        ],
        "dicas": [
          "Os quatro pedestais ficam no Hall da Escada. Fique de frente para cada um e aperte Espaço."
        ]
      }
    ]
  },
