          }
        ]
      },
      {
        "id": "voltar-ao-trinco",
        "objective": "Conte ao Trinco o que o quadro disse.",
        "guia": [
          {
            "map": "map.recepcao",
            "alvo": "trinco"
          }
        ]
      }
    ]
  },
  "luz-na-cozinha": {
    "title": "Luz na Cozinha",
    "kind": "principal",
    "xp": 30,
    "stages": [
      {
        "id": "ir-a-cozinha",
        "objective": "Vá até a Cozinha Bruxa, a leste do Grande Salão.",
        "guia": [
          {
            "map": "map.cozinha",
            "alvo": "dona-brasa"
          }
        ]
      },
      {
        "id": "preparar-drink",
        "objective": "Prepare um Drink Bruxo Fumegante no caldeirão: suco colorido + gelo seco.",
        "completeWhen": {
          "hasItem": "drink-fumegante"
        },
        "then": "entregar-drink",
        "guia": [
          {
            "map": "map.cozinha",
            "alvo": "despensa",
            "when": {
              "not": {
                "all": [
                  {
                    "hasItem": "suco-colorido"
                  },
                  {
                    "hasItem": "gelo-seco"
                  }
                ]
              }
            }
          },
          {
            "map": "map.cozinha",
            "alvo": "caldeirao"
          }
        ]
      },
      {
        "id": "entregar-drink",
        "objective": "Leve o drink para a Dona Brasa.",
        "guia": [
          {
            "map": "map.cozinha",
            "alvo": "dona-brasa"
          }
        ]
      },
      {
        "id": "acender-velas",
        "objective": "Acenda as 2 velas da cozinha com Lumen (troque o feitiço e use a ação).",
        "completeWhen": {
          "all": [
            {
              "flag": "vela:map.cozinha:vela-a"
            },
            {
              "flag": "vela:map.cozinha:vela-b"
            }
          ]
        },
        "then": "falar-com-brasa",
        "guia": [
          {
            "map": "map.cozinha",
            "alvo": "vela-a",
            "when": {
              "not": {
                "flag": "vela:map.cozinha:vela-a"
              }
            }
          },
          {
            "map": "map.cozinha",
            "alvo": "vela-b"
          }
        ]
      },
      {
        "id": "falar-com-brasa",
        "objective": "Volte a falar com a Dona Brasa.",
        "guia": [
          {
            "map": "map.cozinha",
            "alvo": "dona-brasa"
          }
        ]
      }
    ]
  },
  "o-diretor": {
    "title": "O Ministro da Magia",
    "kind": "principal",
    "xp": 40,
    "stages": [
      {
        "id": "ir-ao-corredor",
        "objective": "Vá ao Corredor dos Quadros (porta oeste do Grande Salão) e procure o gabinete do Ministro Bonfatti.",
        "completeWhen": {
          "flag": "visto:morgana-corredor"
        },
        "then": "espantar-sombras",
        "guia": [
          {
            "map": "map.corredor",
            "alvo": "morgana-corredor"
          }
        ]
      },
      {
        "id": "espantar-sombras",
        "objective": "Espante as sombrinhas com Lumen!",
        "completeWhen": {
          "flag": "criaturas:map.corredor:sombras"
        },
        "then": "abrir-grade",
        "guia": [
          {
            "map": "map.corredor",
            "alvo": "sombra-1"
          }
        ]
      },
      {
        "id": "abrir-grade",
        "objective": "Empurre as duas estátuas até as placas do chão para abrir a grade do gabinete.",
        "completeWhen": {
          "flag": "placas:map.corredor:grade"
