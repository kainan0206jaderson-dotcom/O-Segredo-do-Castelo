            "alvo": "grade"
          }
        ]
      },
      {
        "id": "falar-com-diretor",
        "objective": "Converse com o Ministro Bonfatti no gabinete.",
        "guia": [
          {
            "map": "map.gabinete",
            "alvo": "arquimedes"
          }
        ]
      },
      {
        "id": "ir-ao-hall",
        "objective": "Siga o Ministro Bonfatti até o Hall da Escada, no fim oeste do corredor.",
        "guia": [
          {
            "map": "map.hall",
            "alvo": "arquimedes"
          }
        ]
      }
    ]
  },
  "o-selo": {
    "title": "O Selo da Escada",
    "kind": "principal",
    "xp": 80,
    "stages": [
      {
        "id": "reunir-pedras",
        "objective": "Reúna as 4 pedras das casas: Coragem, Inteligência, Astúcia e Lealdade. O Elfo Fuxico, no Grande Salão, dá dicas.",
        "completeWhen": {
          "all": [
            {
              "any": [
                {
                  "hasItem": "pedra-coragem"
                },
                {
                  "flag": "encaixe:map.hall:pedestal-coragem"
                }
              ]
            },
            {
              "any": [
                {
                  "hasItem": "pedra-inteligencia"
                },
                {
                  "flag": "encaixe:map.hall:pedestal-inteligencia"
                }
              ]
            },
            {
              "any": [
                {
                  "hasItem": "pedra-astucia"
                },
                {
                  "flag": "encaixe:map.hall:pedestal-astucia"
                }
              ]
            },
            {
              "any": [
                {
                  "hasItem": "pedra-lealdade"
                },
                {
                  "flag": "encaixe:map.hall:pedestal-lealdade"
                }
              ]
            }
          ]
        },
        "then": "colocar-pedras",
        "guia": [
          {
            "map": "map.hall",
            "alvo": "pedra-coragem",
            "when": {
              "not": {
                "any": [
                  {
                    "hasItem": "pedra-coragem"
                  },
                  {
                    "flag": "encaixe:map.hall:pedestal-coragem"
                  }
                ]
              }
            }
          },
          {
            "map": "map.grande-salao",
            "alvo": "dom-moldura",
            "when": {
              "not": {
                "any": [
                  {
                    "hasItem": "pedra-inteligencia"
                  },
                  {
                    "flag": "encaixe:map.hall:pedestal-inteligencia"
                  }
                ]
              }
            }
          },
          {
            "map": "map.corredor",
            "alvo": "pedra-astucia",
            "when": {
              "not": {
                "any": [
                  {
                    "hasItem": "pedra-astucia"
                  },
                  {
                    "flag": "encaixe:map.hall:pedestal-astucia"
                  }
                ]
              }
            }
          },
          {
            "map": "map.recepcao",
            "alvo": "trinco",
            "when": {
              "not": {
                "any": [
                  {
                    "hasItem": "pedra-lealdade"
                  },
                  {
                    "flag": "encaixe:map.hall:pedestal-lealdade"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "id": "colocar-pedras",
        "objective": "Coloque as 4 pedras nos pedestais do Hall da Escada.",
        "guia": [
          {
            "map": "map.hall",
            "alvo": "pedestal-coragem",
            "when": {
              "not": {
                "flag": "encaixe:map.hall:pedestal-coragem"
              }
            }
          },
          {
            "map": "map.hall",
            "alvo": "pedestal-inteligencia",
            "when": {
              "not": {
                "flag": "encaixe:map.hall:pedestal-inteligencia"
              }
            }
          },
          {
            "map": "map.hall",
            "alvo": "pedestal-astucia",
            "when": {
              "not": {
                "flag": "encaixe:map.hall:pedestal-astucia"
              }
            }
          },
          {
            "map": "map.hall",
            "alvo": "pedestal-lealdade",
            "when": {
              "not": {
                "flag": "encaixe:map.hall:pedestal-lealdade"
              }
            }
          }
        ]
      }
    ]
  },
