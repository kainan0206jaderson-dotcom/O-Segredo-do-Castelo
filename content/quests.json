  "cartas-de-amelia": {
    "title": "As cartas da Amélia",
    "kind": "principal",
    "xp": 80,
    "stages": [
      {
        "id": "subir-escada",
        "objective": "O selo quebrou! Suba a escada do Hall até a Biblioteca, no segundo andar.",
        "completeWhen": {
          "flag": "visto:biblioteca"
        },
        "then": "falar-com-aristoteles",
        "guia": [
          {
            "map": "map.hall",
            "alvo": "porta-biblioteca"
          }
        ],
        "dicas": [
          "No Hall da Escada, a passagem para a Biblioteca fica ao norte, onde estava o selo."
        ]
      },
      {
        "id": "falar-com-aristoteles",
        "objective": "Fale com o Prof. Aristóteles na Biblioteca.",
        "guia": [
          {
            "map": "map.biblioteca",
            "alvo": "aristoteles"
          }
        ],
        "dicas": [
          "O Prof. Aristóteles está na Biblioteca, perto das estantes."
        ]
      },
      {
        "id": "aula-espectral",
        "objective": "Vença a aula de Seres Espectrais, na sala a leste da Biblioteca.",
        "completeWhen": {
          "flag": "aula:vencida"
        },
        "then": "achar-cartas",
        "guia": [
          {
            "map": "map.sala-espectral",
            "alvo": "quadro-aula"
          }
        ],
        "dicas": [
          "A sala da aula fica a leste da Biblioteca. Fale com o quadro de desafios para começar.",
          "Lance Revelar perto dos espectros para vê-los e, logo depois, Lumen. Eles fogem quando aparecem: vá atrás!"
        ]
      },
      {
        "id": "achar-cartas",
        "objective": "Ache 3 cartas brancas escondidas: Biblioteca, sala da aula e Estufa (oeste). Use Revelar.",
        "completeWhen": {
          "all": [
            {
              "hasItem": "carta-amelia-1"
            },
            {
              "hasItem": "carta-amelia-2"
            },
            {
              "hasItem": "carta-amelia-3"
            }
          ]
        },
        "then": "libertar-amelia",
        "guia": [
          {
            "map": "map.biblioteca",
            "alvo": "carta-1",
            "when": {
              "not": {
                "hasItem": "carta-amelia-1"
              }
            }
          },
          {
            "map": "map.sala-espectral",
            "alvo": "carta-3",
            "when": {
              "not": {
                "hasItem": "carta-amelia-3"
              }
            }
          },
          {
            "map": "map.estufa",
            "alvo": "carta-2",
            "when": {
              "not": {
                "hasItem": "carta-amelia-2"
              }
            }
          }
        ],
        "dicas": [
          "As cartas estão escondidas: escolha Revelar e lance perto dos cantos das salas.",
          "Uma na Biblioteca, uma na sala da aula (leste) e uma na Estufa (oeste)."
        ]
      },
      {
        "id": "libertar-amelia",
        "objective": "Leve as cartas ao espelho da Biblioteca.",
        "guia": [
          {
            "map": "map.biblioteca",
            "alvo": "espelho"
          }
        ],
        "dicas": [
          "Com as três cartas, fale com o espelho alto da Biblioteca."
        ]
      },
      {
        "id": "alinhar-estrelas",
        "objective": "No Observatório (norte da Biblioteca), ache a última carta e alinhe as quatro constelações.",
        "completeWhen": {
          "flag": "signos:map.observatorio:estrelas"
        },
        "then": "olhar-telescopio",
        "guia": [
          {
            "map": "map.observatorio",
            "alvo": "carta-4",
            "when": {
              "not": {
                "hasItem": "carta-amelia-4"
              }
            }
          },
          {
            "map": "map.observatorio",
            "alvo": "mostrador-1"
          }
        ],
        "dicas": [
          "A última carta está escondida no Observatório: use Revelar.",
          "A carta diz: coragem é a chama, inteligência é o livro, astúcia é a lua, lealdade é o coração. Gire cada mostrador até o símbolo certo."
        ]
      },
      {
        "id": "olhar-telescopio",
        "objective": "Olhe pelo telescópio do Observatório.",
        "guia": [
          {
            "map": "map.observatorio",
            "alvo": "telescopio"
          }
        ],
        "dicas": [
          "O telescópio fica no meio do Observatório. Fique de frente para ele e aperte Espaço."
        ]
      },
      {
        "id": "abrir-galeria",
        "objective": "Destranque a porta da Galeria (norte da Biblioteca) com o feitiço Abrir.",
        "completeWhen": {
          "flag": "trancado:map.biblioteca:porta-galeria"
        },
        "then": "entrar-galeria",
        "guia": [
          {
            "map": "map.biblioteca",
            "alvo": "porta-galeria"
          }
        ],
        "dicas": [
          "A porta trancada fica ao norte da Biblioteca. Escolha Abrir e fique de frente para ela."
        ]
      },
      {
        "id": "entrar-galeria",
        "objective": "Entre na Galeria dos Quadros.",
        "guia": [
          {
            "map": "map.galeria",
            "alvo": "captura-amelia"
          }
        ],
        "dicas": [
          "A porta da Galeria está aberta, ao norte da Biblioteca."
        ]
      }
    ]
  },
  "as-virtudes": {
    "title": "As quatro virtudes",
    "kind": "principal",
    "xp": 120,
    "stages": [
      {
        "id": "juntar-emblemas",
        "objective": "Entre nos quatro quadros da Galeria e traga os emblemas das virtudes.",
        "completeWhen": {
          "any": [
            {
              "all": [
                {
                  "hasItem": "emblema-coragem"
                },
                {
                  "hasItem": "emblema-inteligencia"
                },
                {
                  "hasItem": "emblema-astucia"
                },
                {
                  "hasItem": "emblema-lealdade"
                }
              ]
            },
            {
              "all": [
                {
                  "kids": true
                },
                {
                  "hasItem": "emblema-coragem"
                },
                {
                  "hasItem": "emblema-lealdade"
                }
              ]
            }
          ]
        },
        "then": "ir-ao-coracao",
        "guia": [
          {
            "map": "map.quadro-coragem",
            "alvo": "emblema",
            "when": {
              "not": {
                "hasItem": "emblema-coragem"
              }
            }
          },
          {
            "map": "map.quadro-inteligencia",
            "alvo": "cristal",
            "when": {
              "all": [
                {
                  "kids": false
                },
                {
                  "all": [
                    {
                      "not": {
                        "hasItem": "emblema-inteligencia"
                      }
                    },
                    {
                      "not": {
                        "flag": "luz:map.quadro-inteligencia:cristal"
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "map": "map.quadro-inteligencia",
            "alvo": "emblema",
            "when": {
              "all": [
                {
                  "kids": false
                },
                {
                  "not": {
                    "hasItem": "emblema-inteligencia"
                  }
                }
              ]
            }
          },
          {
            "map": "map.quadro-astucia",
            "alvo": "emblema",
            "when": {
              "all": [
                {
                  "kids": false
                },
                {
                  "not": {
                    "hasItem": "emblema-astucia"
                  }
                }
              ]
            }
          },
          {
            "map": "map.quadro-lealdade",
            "alvo": "amelia",
            "when": {
              "not": {
                "hasItem": "emblema-lealdade"
              }
            }
          }
        ],
        "kidsObjective": "Entre nos quadros da Coragem e da Lealdade e traga os dois emblemas.",
